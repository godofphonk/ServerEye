# ServerEye Backend Configuration
# Copy to .env and adjust values as needed

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=postgres://servereye:password@localhost:5432/servereye?sslmode=disable

# Authentication
API_KEY=your-secret-api-key-change-in-production

# Kafka Configuration
# Set to true to enable publishing metrics to Kafka for web interface
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=metrics

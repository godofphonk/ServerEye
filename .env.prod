# ServerEye Production Environment Configuration
# Copy this file to .env.local and update values for your environment

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Authentication
API_KEY=prod-api-key-2024-change-me

# Database Configuration (optional)
DATABASE_URL=postgres://postgres:password@postgres:5432/servereye?sslmode=disable

# Kafka Configuration
KAFKA_BROKERS=kafka:9093
KAFKA_TOPIC_PREFIX=servereye

# Domain Configuration
DOMAIN=servereye.dev

# Email for Let's Encrypt
LETSENCRYPT_EMAIL=admin@servereye.dev

# Logging
LOG_LEVEL=info

# Health Check
HEALTH_CHECK_ENABLED=true

# Security
CORS_ALLOWED_ORIGINS=https://servereye.dev

# Performance
HTTP_TIMEOUT=30s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
